rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media attachments for chats / conversations
    match /chat_media/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024; // 50MB max file size
    }

    match /conversations/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024; // 50MB max file size
    }

    // User profile avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10MB max avatar size
    }

    // User Encrypted Backups (Zero-Knowledge Client-Encrypted Blobs)
    match /users/{userId}/backups/{backupId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024; // 100MB max backup size
    }
  }
}

